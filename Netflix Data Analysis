# Importing pandas and matplotlib
import pandas as pd
import matplotlib.pyplot as plt

# Read in the Netflix CSV as a DataFrame
netflix_df = pd.read_csv("netflix_data.csv")
print(netflix_df)

# Start coding here! Use as many cells as you like
movies_1990s=netflix_df[
    (netflix_df['type']=='Movie') & (netflix_df['release_year']>=1990) & (netflix_df['release_year']<=1999)
]

plt.hist(movies_1990s['duration'], bins=20, edgecolor='black')
plt.xlabel('Duration (minutes)')
plt.ylabel('Frequency')
plt.title('Movie Durations in the 1990s')
plt.show()

most_frequent_duration = movies_1990s['duration'].mode()
duration = int(most_frequent_duration)
print(f"The most frequent movie duration in the 1990s is approximately {duration} minutes.")

short_action_movies=netflix_df[
    (netflix_df['type']=='Movie') & (netflix_df['genre'].str.contains('Action', case=False, na=False)) & (netflix_df['release_year']>=1990) & (netflix_df['release_year']<=1999) & (netflix_df['duration']<90)
]
short_movie_count= len(short_action_movies)
print(short_movie_count)